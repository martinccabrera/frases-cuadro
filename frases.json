[
  {
    "linea1": "Nada sin Ti,",
    "linea2": "nada sin nosotros.",
    "autor": "Mater Ter Admirabilis"
  },
  {
    "linea1": "Ella es la gran misionera,",
    "linea2": "Ella obrará milagros.",
    "autor": "P. José Kentenich"
  },
  {
    "linea1": "Quedate con nosotros, Señor,",
    "linea2": "que atardece.",
    "autor": "Emaús - Partida"
  },
  {
    "linea1": "Madre, hazme un instrumento",
    "linea2": "de tu Alianza.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Yo vengo del Amor,",
    "linea2": "vivo y vuelvo al Amor.",
    "autor": "P. José Kentenich"
  },
  {
    "linea1": "Servus Mariae",
    "linea2": "nunquam peribit.",
    "autor": "Fritz Esser"
  },
  {
    "linea1": "María, hazme instrumento",
    "linea2": "de tu amor.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Confío en tu plan,",
    "linea2": "aunque no lo entienda.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Dios escribe recto",
    "linea2": "en renglones torcidos.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Todo es gracia, incluso",
    "linea2": "lo que no logro entender.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Mi vida es misión,",
    "linea2": "quiero reflejar tu amor.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Todo lo puedo en Aquel",
    "linea2": "que me fortalece.",
    "autor": "Filipenses 4:13"
  },
  {
    "linea1": "El Señor es mi pastor,",
    "linea2": "nada me falta.",
    "autor": "Salmo 23"
  },
  {
    "linea1": "No tengas miedo,",
    "linea2": "yo estoy contigo.",
    "autor": "Isaías 41:10"
  },
  {
    "linea1": "Tu gracia me basta,",
    "linea2": "en mi debilidad eres fuerte.",
    "autor": "2 Corintios 12:9"
  },
  {
    "linea1": "La verdad",
    "linea2": "los hará libres.",
    "autor": "Juan 8:32"
  },
  {
    "linea1": "Bienaventurados los",
    "linea2": "limpios de corazón.",
    "autor": "Mateo 5:8"
  },
  {
    "linea1": "Permanezcan en mi amor,",
    "linea2": "como Yo en ustedes.",
    "autor": "Juan 15:9"
  },
  {
    "linea1": "El amor nunca pasa, y",
    "linea2": "en él todo tiene sentido.",
    "autor": "1 Corintios 13:8"
  },
  {
    "linea1": "El Señor es mi luz",
    "linea2": "y mi salvación.",
    "autor": "Salmo 27:1"
  },
  {
    "linea1": "La paz les dejo,",
    "linea2": "mi paz les doy.",
    "autor": "Juan 14:27"
  }
  {
    "linea1": "Todo es gracia.",
    "linea2": "",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Pequeños pasos,",
    "linea2": "gran fe.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Donde estás Tú,",
    "linea2": "encuentro paz.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Ayudame a ser luz",
    "linea2": "en lo simple de hoy.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Amar sin medida,",
    "linea2": "aunque cueste.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Que mi corazón esté",
    "linea2": "siempre abierto a Ti.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Dios es amor, y",
    "linea2": "quien ama permanece.",
    "autor": "1 Juan 4:8"
  },
  {
    "linea1": "Felices los que confían,",
    "linea2": "nunca quedan solos.",
    "autor": "Salmo 84:12"
  }
]

