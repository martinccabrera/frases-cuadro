[
  {
    "linea1": "Nada sin Ti,",
    "linea2": "nada sin nosotros.",
    "autor": "Mater Ter Admirabilis"
  },
  {
    "linea1": "Ella es la gran misionera,",
    "linea2": "Ella obrará milagros.",
    "autor": "P. José Kentenich"
  },
  {
    "linea1": "Quedate con nosotros, Señor,",
    "linea2": "que atardece.",
    "autor": "Emaús - Partida"
  },
  {
    "linea1": "Madre, hazme un instrumento",
    "linea2": "de tu Alianza.",
    "autor": "Schoenstatt"
  }
]
