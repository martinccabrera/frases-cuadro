 [
  {
    "linea1": "Nada sin Ti,",
    "linea2": "nada sin nosotros.",
    "autor": "Mater Ter Admirabilis"
  },
  {
    "linea1": "La familia que reza unida,",
    "linea2": "permanece siempre unida.",
    "autor": "Madre Teresa de Calcuta"
  },
  {
    "linea1": "Ella es la gran misionera,",
    "linea2": "Ella obrará milagros.",
    "autor": "P. José Kentenich"
  },
  {
    "linea1": "Ya sea que vivamos o muramos,",
    "linea2": "del Señor somos.",
    "autor": "Romanos 14:8"
  },
  {
    "linea1": "No te digo hasta 7 veces,",
    "linea2": "sino hasta 70 veces 7",
    "autor": "Mateo 18-22"
  },
  {
    "linea1": "Madre, hazme un instrumento",
    "linea2": "de tu Alianza.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Qué bueno y agradable es",
    "linea2": "que los hermanos vivan unidos.",
    "autor": "Salmo 133:1"
  },
  {
    "linea1": "Yo vengo del Amor,",
    "linea2": "vivo y vuelvo al Amor.",
    "autor": "P. José Kentenich"
  },
  {
    "linea1": "Servus Mariae",
    "linea2": "nunquam peribit.",
    "autor": "Fritz Esser"
  },
  {
    "linea1": "Yo soy",
    "linea2": "la resurrección y la vida;",
    "linea3": "el que cree en mí, vivirá.",
    "autor": "Juan 11:25"
  },
  {
    "linea1": "María, hazme instrumento",
    "linea2": "de tu amor.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Confío en tu plan,",
    "linea2": "aunque no lo entienda.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Dios escribe recto",
    "linea2": "en renglones torcidos.",
    "autor": "Santa Teresa de Ávila"
  },
  {
    "linea1": "Todo es gracia, incluso",
    "linea2": "lo que no logro entender.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Mi vida es misión,",
    "linea2": "quiero reflejar tu amor.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Todo lo puedo en Aquel",
    "linea2": "que me fortalece.",
    "autor": "Filipenses 4:13"
  },
  {
    "linea1": "Dale, Señor, el descanso eterno,",
    "linea2": "y brille para él la luz perpetua.",
    "autor": "Liturgia Católica"
  },
  {
    "linea1": "El Señor es mi pastor,",
    "linea2": "nada me falta.",
    "autor": "Salmo 23"
  },
  {
    "linea1": "No tengas miedo,",
    "linea2": "yo estoy contigo.",
    "autor": "Isaías 41:10"
  },
  {
    "linea1": "Tu gracia me basta,",
    "linea2": "en mi debilidad eres fuerte.",
    "autor": "2 Corintios 12:9"
  },
  {
    "linea1": "La verdad",
    "linea2": "los hará libres.",
    "autor": "Juan 8:32"
  },
  {
    "linea1": "Bienaventurados los",
    "linea2": "limpios de corazón.",
    "autor": "Mateo 5:8"
  },
  {
    "linea1": "Permanezcan en mi amor,",
    "linea2": "como Yo en ustedes.",
    "autor": "Juan 15:9"
  },
  {
    "linea1": "El amor nunca pasa, y",
    "linea2": "en él todo tiene sentido.",
    "autor": "1 Corintios 13:8"
  },
  {
    "linea1": "El Señor es mi luz",
    "linea2": "y mi salvación.",
    "autor": "Salmo 27:1"
  },
  {
    "linea1": "La paz les dejo,",
    "linea2": "mi paz les doy.",
    "autor": "Juan 14:27"
  },
  {
    "linea1": "Todo es gracia.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Pequeños pasos,",
    "linea2": "gran fe.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Amar sin medida,",
    "linea2": "aunque cueste.",
    "autor": "San Agustín"
  },
  {
    "linea1": "Dios es amor, y",
    "linea2": "quien ama permanece.",
    "autor": "1 Juan 4:8"
  },
  {
    "linea1": "Felices los que confían,",
    "linea2": "nunca quedan solos.",
    "autor": "Salmo 84:12"
  },
  {
    "linea1": "Busquen primero",
    "linea2": "el Reino de Dios.",
    "autor": "Mateo 6:33"
  },
  {
    "linea1": "No me abandones,",
    "linea2": "quédate en mí.",
    "autor": "Juan 15:4"
  },
  {
    "linea1": "Madre, llévame",
    "linea2": "al corazón de Dios.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Contigo, María,",
    "linea2": "todo es posible.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "El amor se prueba",
    "linea2": "en las pequeñas cosas.",
    "autor": "P. José Kentenich"
  },
  {
    "linea1": "Dios no falla,",
    "linea2": "aunque yo falle.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Confío, aunque",
    "linea2": "no vea el camino.",
    "autor": "Schoenstatt"
  },
  {
    "linea1": "Ámense como Yo",
    "linea2": "los he amado.",
    "autor": "Juan 15:12"
  },
  {
    "linea1": "Hágase en mí",
    "linea2": "según Tu palabra.",
    "autor": "Lucas 1:38"
  },
  {
    "linea1": "Señor, a quien iría,",
    "linea2": "solo Tú eres vida.",
    "autor": "Juan 6:68"
  },
  {
    "linea1": "El que persevera",
    "linea2": "será salvo.",
    "autor": "Mateo 24:13"
  },
  {
    "linea1": "Hacia Ti, Señor,",
    "linea2": "late nuestro corazón.",
    "autor": "San Agustín"
  },
  {
    "linea1": "La humildad es",
    "linea2": "el camino del amor.",
    "autor": "P. José Kentenich"
  },
  {
    "linea1": "Dios es fiel,",
    "linea2": "siempre lo será.",
    "autor": "1 Corintios 1:9"
  },
  {
    "linea1": "La familia es el santuario",
    "linea2": "donde nace y crece el amor.",
    "autor": "San Juan Pablo II"
  }
]
